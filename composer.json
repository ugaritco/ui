{
    "name": "ugarit/ui",
    "description": "Ugarit UI utilities and presets.",
    "keywords": [
        "ugarit",
        "ui"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "heritage/console": "^1.00.00",
        "heritage/filesystem": "^1.00.00",
        "heritage/support": "^1.00.00",
        "heritage/validation": "^1.00.00",
        "symfony/console": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.35|^8.15|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.3|^10.4|^11.5|^12.5|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Ugarit\\Ui\\": "src/",
            "Heritage\\Foundation\\Auth\\": "auth-backend/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        },
        "ugarit": {
            "providers": [
                "Ugarit\\Ui\\UiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "1.00.00"
}
